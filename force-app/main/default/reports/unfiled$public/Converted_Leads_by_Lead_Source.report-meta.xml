<?xml version="1.0" encoding="UTF-8" ?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <chart>
        <chartType>Bar</chartType>
        <groupingColumn>LEAD.LEAD_SOURCE</groupingColumn>
        <legendPosition>Bottom</legendPosition>
        <showValues>true</showValues>
    </chart>
    <columns>LEAD.NAME</columns>
    <columns>LEAD.COMPANY</columns>
    <columns>LEAD.LEAD_SOURCE</columns>
    <columns>LEAD.CONVERTED_DATE</columns>
    <description
  >Converted Leads only, grouped by original Lead Source. Results are limited to Lead fields retained and exposed by the standard Leads report type after conversion.</description>
    <filter>
        <criteriaItems>
            <column>LEAD.IS_CONVERTED</column>
            <operator>equals</operator>
            <value>true</value>
        </criteriaItems>
    </filter>
    <groupingsDown>
        <field>LEAD.LEAD_SOURCE</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Converted Leads by Lead Source</name>
    <reportType>Leads</reportType>
</Report>
