<?xml version="1.0" encoding="UTF-8" ?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <chart>
        <chartSummaries>
            <aggregate>RecordCount</aggregate>
            <column>RowCount</column>
        </chartSummaries>
        <chartType>HorizontalBar</chartType>
        <groupingColumn>LEAD.OWNER_NAME</groupingColumn>
        <legendPosition>Bottom</legendPosition>
        <showValues>true</showValues>
    </chart>
    <columns>LEAD.NAME</columns>
    <columns>LEAD.COMPANY</columns>
    <columns>LEAD.OWNER_NAME</columns>
    <columns>LEAD.LEAD_SOURCE</columns>
    <columns>LEAD.LEAD_PRIORITY__C</columns>
    <description
  >High-priority Leads, grouped by Lead Owner. Priority is the value saved by the existing Lead Priority Flow.</description>
    <format>Summary</format>
    <groupingsDown>
        <field>LEAD.OWNER_NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>High Priority Leads by Owner</name>
    <reportOptions>
        <filter>
            <column>LEAD.LEAD_PRIORITY__C</column>
            <operator>equals</operator>
            <value>High</value>
        </filter>
    </reportOptions>
    <reportType>Leads</reportType>
</Report>
