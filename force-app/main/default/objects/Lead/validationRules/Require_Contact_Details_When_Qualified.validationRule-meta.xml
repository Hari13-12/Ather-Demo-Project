<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Contact_Details_When_Qualified</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(ISPICKVAL(Status, &quot;Closed - Converted&quot;), OR(ISBLANK(Email), ISBLANK(Phone)))</errorConditionFormula>
    <errorMessage
  >Provide an email address and phone number before qualifying this Lead.</errorMessage>
</ValidationRule>
